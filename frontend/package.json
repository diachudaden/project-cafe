{
  "name": "chonrieng-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ui",
    "packages/auth",
    "apps/admin",
    "apps/pos",
    "apps/customer"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=@chonrieng/admin",
    "dev:pos": "npm run dev --workspace=@chonrieng/pos",
    "dev:customer": "npm run dev --workspace=@chonrieng/customer",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.0"
  }
}
