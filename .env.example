# Local EF Core tooling connection. Replace with your SQL Server connection string.
ConnectionStrings__DefaultConnection=''
Jwt__SigningKey=''
Jwt__Issuer='CafeCR'
Jwt__Audience='CafeCR.Api'
BootstrapAdmin__Email=''
BootstrapAdmin__Password=''
BootstrapAdmin__FullName='Administrator'
DevelopmentSeed__Password=''
# Optional: first day of seeded history (default: first day of last month).
DevelopmentSeed__HistoryFrom=
Payment__Bank='SePay'
Payment__AccountNumber='0000000000'
Payment__AccountHolder='Cafe CR'
Payment__CodePrefix='TT'
Payment__QrImageBaseUrl='https://qr.sepay.vn/img'
Payment__HoldMinutes=10
Payment__WebhookSecret='demo-sepay-secret'
Payment__TimestampToleranceSeconds=300
Payment__ValidateOnStart=true
# Auto-release overdue seats: minutes past the paid end time (0 disables, max 240) and check interval (10-3600 s).
Sessions__AutoReleaseGraceMinutes=10
Sessions__AutoReleaseIntervalSeconds=60
# Inventory (TASK-027): count tolerance floor/percent, rotation for non-daily items, background jobs on/off.
Inventory__ToleranceMinUnits=2
Inventory__TolerancePercent=0.08
Inventory__RotationDays=3
Inventory__JobsEnabled=true
# Email (TASK-028). Dev: Mailpit (defaults below, UI http://localhost:8025).
# Gmail: Email__Host='smtp.gmail.com', Email__Port=587, Email__UseStartTls=true, Username/FromAddress = the Gmail
# address, Password = a 16-character App Password (Google account > Security > App passwords). Never commit them.
Email__Host='mailpit'
Email__Port=1025
Email__Username=''
Email__Password=''
Email__FromAddress='no-reply@chonrieng.local'
Email__FromName='Chọn Riêng Cafe'
Email__UseStartTls=false
# Public origin of the web apps, no trailing slash (e.g. https://cafe.example). Reset links point here.
App__PublicBaseUrl='http://localhost'
PasswordReset__TokenMinutes=15
API_PORT=8080
WEB_PORT=80

# set -a
# source .env
# set +a
# dotnet tool restore
# dotnet ef database update \
#   --project backend/src/ChonRieng.Infrastructure \
#   --startup-project backend/src/ChonRieng.Api
# unset ConnectionStrings__DefaultConnection