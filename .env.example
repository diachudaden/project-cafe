# Local EF Core tooling connection. Replace with your SQL Server connection string.
ConnectionStrings__DefaultConnection=''
Jwt__SigningKey=''
Jwt__Issuer='CafeCR'
Jwt__Audience='CafeCR.Api'
BootstrapAdmin__Email=''
BootstrapAdmin__Password=''
BootstrapAdmin__FullName='Administrator'
DevelopmentSeed__Password=''
# Optional: first day of seeded history (default: first day of last month).
DevelopmentSeed__HistoryFrom=
Payment__Bank='SePay'
Payment__AccountNumber='0000000000'
Payment__AccountHolder='Cafe CR'
Payment__CodePrefix='TT'
Payment__QrImageBaseUrl='https://qr.sepay.vn/img'
Payment__HoldMinutes=10
Payment__WebhookSecret='demo-sepay-secret'
Payment__TimestampToleranceSeconds=300
Payment__ValidateOnStart=true
API_PORT=8080
WEB_PORT=80

