                        <mxPoint x="1195" y="1080" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pay-14" value="1. POST /api/payments/bills/{id}/qr" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="145" y="175" as="sourcePoint"/>
                        <mxPoint x="355" y="175" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pay-15" value="2. Bill Pending? · Seat.Hold(HeldUntil = now+10&#39;)" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="355" y="235" as="sourcePoint"/>
                        <mxPoint x="565" y="235" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pay-16" value="3. {qrUrl, code: CR1024, amount, expiresAt}" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="355" y="295" as="sourcePoint"/>
                        <mxPoint x="145" y="295" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pay-17" value="4. &amp;lt;img src=qrUrl&amp;gt;" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="145" y="355" as="sourcePoint"/>
                        <mxPoint x="775" y="355" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pay-18" value="5. ảnh QR (acc, bank, amount, des)" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="775" y="415" as="sourcePoint"/>
                        <mxPoint x="145" y="415" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pay-19" value="6. khách quét &amp; chuyển tiền → NH báo về SePay" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="985" y="520" as="sourcePoint"/>
                        <mxPoint x="1195" y="520" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pay-20" value="7. POST /api/webhooks/sepay (HMAC + timestamp)" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#d79b00;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1195" y="580" as="sourcePoint"/>
                        <mxPoint x="355" y="580" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pay-21" value="8. verify chữ ký · |now−ts| ≤ 300s&lt;br&gt;sai → 401" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="365" y="618" width="220" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="pay-22" value="9. 1 transaction: insert PaymentTransactions (SepayId UNIQUE)" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="355" y="685" as="sourcePoint"/>
                        <mxPoint x="565" y="685" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pay-23" value="10. khớp CR{BillId} → Bill.MarkPaid · SeatAllocator · Session.Start" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="355" y="745" as="sourcePoint"/>
                        <mxPoint x="565" y="745" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pay-24" value="11. LedgerEntry Thu (SeatSale, VietQr) → COMMIT" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="355" y="805" as="sourcePoint"/>
                        <mxPoint x="565" y="805" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pay-25" value="12. 200 {&quot;success&quot;: true}  (&lt; 30s)" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="355" y="865" as="sourcePoint"/>
                        <mxPoint x="1195" y="865" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pay-26" value="13. SignalR PaymentReceived + SeatAssigned" style="html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="355" y="925" as="sourcePoint"/>
                        <mxPoint x="145" y="925" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pay-27" value="🔔 &amp;quot;tink tink&amp;quot; + đọc &amp;quot;Đã nhận 25.000 đồng&amp;quot; + hiện số bàn" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="60" y="965" width="300" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="pay-28" value="&lt;b&gt;Nhánh lỗi (bước 10)&lt;/b&gt;&lt;br&gt;• code null / bill không tồn tại → &lt;b&gt;Unmatched&lt;/b&gt;&lt;br&gt;• bill đã Paid → &lt;b&gt;Duplicate&lt;/b&gt; (hoàn tay)&lt;br&gt;• chuyển thiếu → &lt;b&gt;Underpaid&lt;/b&gt;, bill giữ Pending&lt;br&gt;• chuyển dư → &lt;b&gt;Overpaid&lt;/b&gt;, vẫn coi là đã trả&lt;br&gt;→ đẩy &lt;i&gt;PaymentNeedsAttention&lt;/i&gt; cho POS / managers&lt;br&gt;→ ShiftLead/Manager: &lt;b&gt;assign&lt;/b&gt; hoặc &lt;b&gt;dismiss&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Chống trùng&lt;/b&gt;: SePay gửi lại cùng id → trả success, không ghi gì thêm.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hết hạn giữ chỗ&lt;/b&gt;: job mỗi phút nhả ghế → SeatHoldExpired.&lt;br&gt;&lt;br&gt;&lt;b&gt;Đêm 00:30&lt;/b&gt;: ReconcileVietQr so Ledger ↔ PaymentTransactions." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="1320" y="160" width="300" height="330" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
